# Safe default: no live mailbox access, no draft creation, no real sending.
DRY_RUN=true
LIVE_MAILBOX_AUTHORIZED=false
DATABASE_PATH=data/alumni.db
MAILBOX=alumni@upes.ac.in
# Intended staff setup: directly signed-in alumni account. UPES IT must verify its
# Exchange RecipientTypeDetails; change to shared if necessary. Never infer verification.
MAILBOX_TYPE=standalone
MAILBOX_TYPE_VERIFIED=false

# HTTPS origin that serves both add-in assets and the backend API.
# Outlook requires a trusted TLS certificate, including for localhost sideloading.
BASE_URL=https://localhost:8000

# Single institutional tenant (public UUID, not a secret).
MS_TENANT_ID=
# API app registration: single-tenant, requestedAccessTokenVersion=2,
# expose api://<API_CLIENT_ID>/access_as_user as a delegated scope.
API_CLIENT_ID=
# Separate public SPA app registration for the Outlook add-in; no client secret.
ADDIN_CLIENT_ID=
# Comma-separated Entra USER object UUIDs allowed to administer this mailbox.
# This is checked by the server on EVERY API request. Empty denies all access.
ADMIN_OBJECT_IDS=

# Separate background-worker app registration. These secrets NEVER reach the sidebar.
MS_CLIENT_ID=
MS_CLIENT_SECRET=
# Required for first and subsequent authorized ingestion. UTC ISO timestamp with Z.
# Select the intended backlog start with UPES IT; keep unchanged after activation.
MS_INGEST_SINCE=

# Authority addresses are stored in the database via Routing & health inside the add-in.
# Rita Godiyal and Hemant Kumar addresses begin NULL; do not guess either address.
